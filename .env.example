# Local Docker Compose configuration. Replace this example password before use.
# A long password using letters, digits, underscores, and hyphens is simplest.
POSTGRES_PASSWORD=replace-this-local-password
APP_PORT=3000

# Development-only: confirmed reset of the signed-in account’s workout data.
# Keep disabled for normal workout data.
ENABLE_DEV_RESET=false

# Register a Google OAuth web client before starting the authenticated app.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
